{
  "packageManager": "yarn@4.12.0",
  "dependencies": {
    "@calcit/procs": "0.13.66",
    "nanoid": "^5.1.5"
  },
  "scripts": {
    "watch-server": "calcit --entry server js -w",
    "compile-server": "calcit --entry server js",
    "compile-page": "calcit --emit-path out-page/ js",
    "build-page": "vite build --base=./",
    "watch-page": "calcit --emit-path out-page/ js -w",
    "check:unit": "calcit test --tag unit --require-match --summary-only --format json",
    "check:deprecated": "calcit analyze deprecated --summary-only --format json",
    "check:client-generation": "node scripts/check-client-generation.mjs"
  },
  "devDependencies": {
    "vite": "^8.0.2",
    "ws": "^8.18.2"
  },
  "version": "0.0.21"
}
